# ============================================================================
# CONECTADES - VARIÁVEIS DE AMBIENTE
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com dados sensíveis!


# ============================================================================
# BANCO DE DADOS
# ============================================================================
DB_HOST=db
DATABASE_URL=postgresql://admin_conectades:conectaZ0Z6%40@db:5432/conectades


# ============================================================================
# DJANGO
# ============================================================================
DJANGO_SETTINGS_MODULE=backend.core.settings
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True


# ============================================================================
# URLS DO SISTEMA
# ============================================================================
SITE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000


# ============================================================================
# CONFIGURAÇÃO DE EMAIL
# ============================================================================

# Escolha o backend: 'console', 'smtp' ou 'file'
# - console: Apenas exibe emails no terminal (desenvolvimento)
# - smtp: Envia emails reais via SMTP
# - file: Salva emails em arquivos (desenvolvimento/testes)
EMAIL_BACKEND=console

# ---- OPÇÃO 1: Gmail (Desenvolvimento/Pequeno Volume) ----
# Passo 1: Ativar verificação em 2 etapas: https://myaccount.google.com/security
# Passo 2: Criar senha de app: https://myaccount.google.com/apppasswords
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app-16-caracteres
# DEFAULT_FROM_EMAIL=noreply@conectades.com
# SERVER_EMAIL=admin@conectades.com

# ---- OPÇÃO 2: SendGrid (Produção Recomendada) ----
# Passo 1: Criar conta: https://signup.sendgrid.com/
# Passo 2: Criar API Key: Settings → API Keys → Create API Key
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.sua-chave-api-aqui
# DEFAULT_FROM_EMAIL=noreply@conectades.com
# SERVER_EMAIL=admin@conectades.com

# ---- OPÇÃO 3: Mailgun ----
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=postmaster@seu-dominio.mailgun.org
# EMAIL_HOST_PASSWORD=sua-senha-mailgun
# DEFAULT_FROM_EMAIL=noreply@conectades.com
# SERVER_EMAIL=admin@conectades.com

# ---- OPÇÃO 4: Salvar em arquivos (Desenvolvimento) ----
# EMAIL_BACKEND=file
# EMAIL_FILE_PATH=/tmp/conectades-emails


# ============================================================================
# REDIS (Cache)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379


